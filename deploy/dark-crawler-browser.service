[Unit]
Description=Dark Crawler remote captcha browser (Xvfb + Firefox + noVNC)
After=dark-crawler-tor.service network.target
Wants=dark-crawler-tor.service

[Service]
Type=simple
User=darkcrawler
Group=darkcrawler
WorkingDirectory=/opt/dark-crawler
Environment=PYTHONUNBUFFERED=1
Environment=DARK_CRAWLER_ROOT=/opt/dark-crawler
Environment=DARK_CRAWLER_CONFIG=/opt/dark-crawler/config.yaml
Environment=TOR_SOCKS_HOST=127.0.0.1
Environment=TOR_SOCKS_PORT=19050
Environment=BROWSER_DISPLAY=99
Environment=BROWSER_VNC_PORT=5901
Environment=BROWSER_WS_PORT=6080
Environment=BROWSER_IDLE_SECONDS=1800
Environment=BROWSER_PROFILE_DIR=/opt/dark-crawler/data/browser-profile
EnvironmentFile=-/opt/dark-crawler/deploy/web.env
ExecStart=/opt/dark-crawler/deploy/browser-session.sh
Restart=no
Nice=5
MemoryMax=1200M
TasksMax=256
PrivateTmp=true
# On-demand only: started from the Web UI Auth page.

[Install]
WantedBy=multi-user.target
