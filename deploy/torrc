# Isolated Tor instance for dark-crawler (avoids clashing with default 9050/9051)
# Process user is set by systemd (User=debian-tor); do not set User here.
DataDirectory /var/lib/dark-crawler-tor
PidFile /run/dark-crawler-tor/tor.pid

# Bind localhost only — not exposed publicly.
# IsolateSOCKSAuth groups streams by the crawler's fixed SOCKS login.
SocksPort 127.0.0.1:19050 IsolateSOCKSAuth
# Reuse one circuit for new streams for 24 hours. The default is 10 minutes.
MaxCircuitDirtiness 86400
ControlPort 127.0.0.1:19051
CookieAuthentication 1
CookieAuthFile /var/lib/dark-crawler-tor/control_auth_cookie

Log notice file /var/log/dark-crawler/tor.log
Log notice stdout
RunAsDaemon 0
SafeLogging 1

# Keep memory lower on small VPS
AvoidDiskWrites 0
MaxMemInQueues 64 MB
